<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard de Calidad Operativa</title>
  <!-- Tabler Icons & Chart.js para gráficos -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    :root {
      --bg-app: #0f172a;
      --bg-card: #1e293b;
      --border-color: #334155;
      --color-primary: #38bdf8;
      --color-success: #10b981;
      --color-warning: #f59e0b;
      --color-danger: #ef4444;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { background: var(--bg-app); color: var(--text-main); padding: 2rem; }
    
    .header-dash { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem; }
    .title-area h1 { font-size: 24px; font-weight: 700; color: #fff; }
    .title-area p { color: var(--text-muted); font-size: 14px; margin-top: 4px; }
    
    .nav-tabs { display: flex; gap: 10px; margin-bottom: 2rem; }
    .tab-btn { background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-muted); padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 14px; transition: all 0.2s; display: flex; align-items: center; gap: 8px; }
    .tab-btn.active { background: var(--color-primary); color: #000; border-color: var(--color-primary); }
    
    .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; margin-bottom: 2rem; }
    .kpi-card { background: var(--bg-card); border: 1px solid var(--border-color); padding: 1.5rem; border-radius: 12px; position: relative; }
    .kpi-card .kpi-title { font-size: 13px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; }
    .kpi-card .kpi-val { font-size: 28px; font-weight: 700; margin-top: 8px; color: #fff; }
    .kpi-card i { position: absolute; right: 1.5rem; top: 1.5rem; font-size: 24px; color: var(--color-primary); }
    
    .view-section { display: none; }
    .view-section.active { display: block; }
    
    .dash-row { display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; margin-bottom: 2rem; }
    @media (max-width: 900px) { .dash-row { grid-template-columns: 1fr; } }
    
    .card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 1.5rem; height: 100%; }
    .card-title { font-size: 16px; font-weight: 700; margin-bottom: 1.2rem; color: #fff; display: flex; justify-content: space-between; align-items: center; }
    
    .selector-box { background: var(--bg-card); border: 1px solid var(--border-color); color: #fff; padding: 10px; border-radius: 8px; width: 250px; font-size: 14px; margin-bottom: 1.5rem; outline: none; }
    
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; }
    th { color: var(--text-muted); padding: 10px; border-bottom: 2px solid var(--border-color); font-weight: 600; }
    td { padding: 12px 10px; border-bottom: 1px solid var(--border-color); color: var(--text-main); }
    
    .badge { padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: 700; display: inline-block; }
    .b-ok { background: rgba(16, 185, 129, 0.15); color: #10b981; }
    .b-mid { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
    .b-no { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
    
    .text-list-item { background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); padding: 12px; border-radius: 8px; margin-bottom: 10px; font-size: 13px; line-height: 1.4; }
    .text-list-item strong { color: var(--color-primary); display: block; margin-bottom: 4px; font-size: 11px; text-transform: uppercase; }
    
    .loader-container { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 300px; gap: 1rem; }
    .spinner { width: 40px; height: 40px; border: 4px solid rgba(255,255,255,0.1); border-top-color: var(--color-primary); border-radius: 50%; animation: spin 1s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>

  <div class="header-dash">
    <div class="title-area">
      <h1>Tablero de Calidad Operativa</h1>
      <p>Fundación Cenedudes · Resumen unificado de gestión de canales</p>
    </div>
    <div id="sync-status" class="badge b-mid"><i class="ti ti-refresh-dot"></i> Conectando con Google Sheets...</div>
  </div>

  <div class="nav-tabs">
    <button class="tab-btn active" onclick="switchTab('grupal')"><i class="ti ti-users"></i> Vista Grupal</button>
    <button class="tab-btn" onclick="switchTab('individual')"><i class="ti ti-user"></i> Evolución Individual</button>
  </div>

  <!-- PANTALLA DE CARGA -->
  <div id="loader" class="loader-container">
    <div class="spinner"></div>
    <p style="color: var(--text-muted)">Descargando y procesando auditorías...</p>
  </div>

  <!-- DASHBOARD PRINCIPAL (OCULTO AL INICIO) -->
  <div id="main-content" style="display: none;">
    
    <!-- METRICAS MACRO GENERALES -->
    <div class="kpi-grid">
      <div class="kpi-card">
        <div class="kpi-title">Auditorías Totales</div>
        <div class="kpi-val" id="kpi-total">—</div>
        <i class="ti ti-file-analytics"></i>
      </div>
      <div class="kpi-card">
        <div class="kpi-title">Promedio General</div>
        <div class="kpi-val" id="kpi-promedio">—</div>
        <i class="ti ti-chart-bar"></i>
      </div>
      <div class="kpi-card">
        <div class="kpi-title">Efectividad de Cierre</div>
        <div class="kpi-val" id="kpi-cierres">—</div>
        <i class="ti ti-trophy"></i>
      </div>
      <div class="kpi-card">
        <div class="kpi-title">Alertas Críticas</div>
        <div class="kpi-val" id="kpi-alertas" style="color: var(--color-danger)">—</div>
        <i class="ti ti-alert-triangle" style="color: var(--color-danger)"></i>
      </div>
    </div>

    <!-- SECCIÓN VISTA GRUPAL -->
    <div id="view-grupal" class="view-section active">
      <div class="dash-row">
        <div class="card">
          <div class="card-title">Ranking de Calidad por Asesor</div>
          <div style="overflow-x: auto;">
            <table id="ranking-table">
              <thead>
                <tr>
                  <th>Asesor</th>
                  <th>Gestiones</th>
                  <th>Promedio</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody><!-- Dinámico --></tbody>
            </table>
          </div>
        </div>
        <div class="card">
          <div class="card-title">Distribución por Canales</div>
          <div style="height: 220px; display:flex; align-items:center; justify-content:center;">
            <canvas id="chartCanales"></canvas>
          </div>
        </div>
      </div>
    </div>

    <!-- SECCIÓN VISTA INDIVIDUAL -->
    <div id="view-individual" class="view-section">
      <select id="selector-asesor" class="selector-box" onchange="renderIndividualData()">
        <option value="">— Seleccionar Asesor —</option>
      </select>
      
      <div class="dash-row">
        <div class="card">
          <div class="card-title">Evolución de Calidad (Histórico)</div>
          <div style="position: relative; height: 250px;">
            <canvas id="chartEvolucion"></canvas>
          </div>
        </div>
        <div class="card" style="display: flex; flex-direction: column; gap: 1rem;">
          <div>
            <div class="kpi-title" style="font-size:11px">Promedio Individual</div>
            <div class="kpi-val" id="ind-promedio" style="font-size:36px; color:var(--color-primary)">—</div>
          </div>
          <div>
            <div class="kpi-title" style="font-size:11px">Mix Operativo</div>
            <div style="font-size:14px; margin-top:6px" id="ind-mix">Llamadas: 0 | WhatsApp: 0</div>
          </div>
        </div>
      </div>

      <!-- FEEDBACK CUALITATIVO EXTRAÍDO DEL SHEET -->
      <div class="dash-row" style="grid-template-columns: 1fr 1fr 1fr;">
        <div class="card">
          <div class="card-title" style="color: var(--color-success)"><i class="ti ti-thumb-up"></i> Fortalezas Recurrentes</div>
          <div id="lista-fortalezas" style="max-height: 250px; overflow-y:auto;"></div>
        </div>
        <div class="card">
          <div class="card-title" style="color: var(--color-warning)"><i class="ti ti-trending-up"></i> Áreas de Mejora Prioritarias</div>
          <div id="lista-mejoras" style="max-height: 250px; overflow-y:auto;"></div>
        </div>
        <div class="card">
          <div class="card-title" style="color: var(--color-primary)"><i class="ti ti-target-arrow"></i> Últimos Compromisos Asumidos</div>
          <div id="lista-compromisos" style="max-height: 250px; overflow-y:auto;"></div>
        </div>
      </div>
    </div>

  </div>

  <script>
    // ==========================================
    // CONFIGURACIÓN: PEGA TU URL DE IMPLEMENTACIÓN DE APPS SCRIPT ACÁ
    // ==========================================
    const SCRIPT_READ_URL = "https://script.google.com/macros/s/AKfycbyLBxpMe3Odp4uw_6Ra4_tDI3eZfFlUnSjZsKEdppI_cV4wJUTgSN48jBg-R2N6CY_cRw/exec";
    // ==========================================

    let rawData = [];
    let chartCanalesRef = null;
    let chartEvolucionRef = null;

    window.addEventListener('DOMContentLoaded', () => {
      fetch(SCRIPT_READ_URL)
        .then(res => res.json())
        .then(res => {
          if(res.status === "success") {
            rawData = res.data;
            document.getElementById('sync-status').className = "badge b-ok";
            document.getElementById('sync-status').innerHTML = '<i class="ti ti-circle-check"></i> Sincronizado';
            document.getElementById('loader').style.display = 'none';
            document.getElementById('main-content').style.display = 'block';
            procesarDashboard();
          } else {
            throw new Error(res.message);
          }
        })
        .catch(err => {
          console.error(err);
          document.getElementById('sync-status').className = "badge b-no";
          document.getElementById('sync-status').innerHTML = '<i class="ti ti-cloud-off"></i> Error de conexión';
        });
    });

    function switchTab(tab) {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.view-section').forEach(s => s.classList.remove('active'));
      event.currentTarget.classList.add('active');
      document.getElementById('view-' + tab).classList.add('active');
    }

    function procesarDashboard() {
      if(rawData.length === 0) return;
      
      // KPIs Globales
      document.getElementById('kpi-total').textContent = rawData.length;
      
      let sumNotas = 0;
      let cierres = 0;
      let alertas = 0;
      let contadoresCanal = { "New Lead": 0, "Remarketing": 0, "WhatsApp": 0 };
      let asesoresSet = new Set();

      rawData.forEach(row => {
        sumNotas += parseFloat(row["Nota Final"] || 0);
        if(row["Lead Arancelado"] === "SI" || row["Lead arancelado"] === "SI") cierres++;
        if(row["Error Crítico: Falta de Respeto"] === "SI" || row["Error Crítico: Venta Fraudulenta"] === "SI") alertas++;
        if(contadoresCanal[row["Canal / Tipo de Gestión"]] !== undefined) contadoresCanal[row["Canal / Tipo de Gestión"]]++;
        if(row["Asesor"]) asesoresSet.add(row["Asesor"]);
      });

      document.getElementById('kpi-promedio').textContent = Math.round(sumNotas / rawData.length) + "%";
      document.getElementById('kpi-cierres').textContent = Math.round((cierres / rawData.length) * 100) + "%";
      document.getElementById('kpi-alertas').textContent = alertas;

      // Cargar selector de asesores
      const selector = document.getElementById('selector-asesor');
      Array.from(asesoresSet).sort().forEach(a => {
        let opt = document.createElement('option');
        opt.value = a; opt.textContent = a;
        selector.appendChild(opt);
      });

      // Renderizar Tabla de Ranking Grupal
      let ranking = {};
      rawData.forEach(row => {
        if(!ranking[row.Asesor]) ranking[row.Asesor] = { notas: 0, cant: 0 };
        ranking[row.Asesor].notas += parseFloat(row["Nota Final"] || 0);
        ranking[row.Asesor].cant++;
      });

      let rankingArr = Object.keys(ranking).map(name => {
        return { name: name, promedio: Math.round(ranking[name].notas / ranking[name].cant), cant: ranking[name].cant };
      }).sort((a,b) => b.promedio - a.promedio);

      const tbody = document.querySelector('#ranking-table tbody');
      tbody.innerHTML = rankingArr.map(r => {
        let cls = r.promedio >= 70 ? 'b-ok' : r.promedio >= 40 ? 'b-mid' : 'b-no';
        let txt = r.promedio >= 70 ? 'Aprobado' : r.promedio >= 40 ? 'En desarrollo' : 'Incompleto';
        return `<tr>
          <td><strong>${r.name}</strong></td>
          <td>${r.cant} gds.</td>
          <td style="font-weight:700; color:var(--color-primary)">${r.promedio}%</td>
          <td><span class="badge ${cls}">${txt}</span></td>
        </tr>`;
      }).join('');

      // Gráfico de Tortas - Canales
      const ctxCanales = document.getElementById('chartCanales').getContext('2d');
      chartCanalesRef = new Chart(ctxCanales, {
        type: 'pie',
        data: {
          labels: Object.keys(contadoresCanal),
          datasets: [{
            data: Object.values(contadoresCanal),
            backgroundColor: ['#38bdf8', '#a78bfa', '#10b981'],
            borderWidth: 0
          }]
        },
        options: { plugins: { legend: { labels: { color: '#fff' } } } }
      });
    }

    function renderIndividualData() {
      const name = document.getElementById('selector-asesor').value;
      if(!name) return;

      const filtrado = rawData.filter(r => r.Asesor === name).sort((a,b) => new Date(a.Fecha) - new Date(b.Fecha));
      
      // Promedio individual
      let sum = filtrado.reduce((acc, r) => acc + parseFloat(r["Nota Final"] || 0), 0);
      let prom = Math.round(sum / filtrado.length);
      document.getElementById('ind-promedio').textContent = prom + "%";

      // Mix de canales
      let calls = filtrado.filter(r => r["Canal / Tipo de Gestión"] !== "WhatsApp").length;
      let was = filtrado.filter(r => r["Canal / Tipo de Gestión"] === "WhatsApp").length;
      document.getElementById('ind-mix').textContent = `Llamadas: ${calls} | WhatsApp: ${was}`;

      // Listas de texto cualitativo (Últimas 5 auditorías)
      const ultimas = filtrado.slice(-5).reverse();
      
      document.getElementById('lista-fortalezas').innerHTML = ultimas.map(r => r["Fortalezas Identificadas"] && r["Fortalezas Identificadas"] !== '—' ? `<div class="text-list-item"><strong>Auditoría ${r.Fecha}</strong>${r["Fortalezas Identificadas"]}</div>` : '').join('') || '<p style="color:var(--text-muted); font-size:13px;">Sin registros.</p>';
      document.getElementById('lista-mejoras').innerHTML = ultimas.map(r => r["Áreas de Mejora Prioritarias"] && r["Áreas de Mejora Prioritarias"] !== '—' ? `<div class="text-list-item"><strong>Auditoría ${r.Fecha}</strong>${r["Áreas de Mejora Prioritarias"]}</div>` : '').join('') || '<p style="color:var(--text-muted); font-size:13px;">Sin registros.</p>';
      
      document.getElementById('lista-compromisos').innerHTML = ultimas.map(r => {
        let items = [r["Acción / Compromiso 1"], r["Acción / Compromiso 2"], r["Acción / Compromiso 3"]].filter(c => c && c !== '—');
        if(items.length === 0) return '';
        return `<div class="text-list-item"><strong>Acuerdos del ${r.Fecha}</strong>${items.map(i => `• ${i}`).join('<br>')}</div>`;
      }).join('') || '<p style="color:var(--text-muted); font-size:13px;">Sin compromisos anotados.</p>';

      // Gráfico de evolución temporal (Línea)
      const labels = filtrado.map(r => r.Fecha);
      const scores = filtrado.map(r => parseFloat(r["Nota Final"] || 0));

      if (chartEvolucionRef) chartEvolucionRef.destroy();

      const ctxEvolucion = document.getElementById('chartEvolucion').getContext('2d');
      chartEvolucionRef = new Chart(ctxEvolucion, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [{
            label: 'Calidad %',
            data: scores,
            borderColor: '#38bdf8',
            backgroundColor: 'rgba(56, 189, 248, 0.1)',
            fill: true,
            tension: 0.2
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: { grid: { color: '#334155' }, ticks: { color: '#94a3b8' } },
            y: { min: 0, max: 100, grid: { color: '#334155' }, ticks: { color: '#94a3b8' } }
          },
          plugins: { legend: { display: false } }
        }
      });
    }
  </script>
</body>
</html>
